<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundleIdentifier</key>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
        <key>CFBundleName</key>
        <string>$(PRODUCT_NAME)</string>
        <key>CFBundleDisplayName</key>
        <string>Nano Ewallet</string>
        <key>CFBundleExecutable</key>
        <string>$(EXECUTABLE_NAME)</string>
        <key>CFBundlePackageType</key>
        <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
        <key>CFBundleShortVersionString</key>
        <string>$(MARKETING_VERSION)</string>
        <key>CFBundleVersion</key>
        <string>$(CURRENT_PROJECT_VERSION)</string>
        <key>CFBundleInfoDictionaryVersion</key>
        <string>6.0</string>

        <!-- Base URL cho backend — inject từ .env qua Config.xcconfig lúc build -->
        <key>BE_BASE_URL</key>
        <string>$(BE_BASE_URL)</string>
        <key>UIApplicationSceneManifest</key>
        <dict>
            <key>UIApplicationSupportsMultipleScenes</key>
            <false/>
        </dict>
        <key>UIApplicationSupportsIndirectInputEvents</key>
        <true/>
        <key>UILaunchScreen</key>
        <dict/>
        <key>UISupportedInterfaceOrientations</key>
        <array>
            <string>UIInterfaceOrientationPortrait</string>
            <string>UIInterfaceOrientationLandscapeLeft</string>
            <string>UIInterfaceOrientationLandscapeRight</string>
        </array>
        <key>UISupportedInterfaceOrientations~ipad</key>
        <array>
            <string>UIInterfaceOrientationPortrait</string>
            <string>UIInterfaceOrientationPortraitUpsideDown</string>
            <string>UIInterfaceOrientationLandscapeLeft</string>
            <string>UIInterfaceOrientationLandscapeRight</string>
        </array>

        <!-- Camera: quét CCCD / eKYC face capture — tương ứng android.permission.CAMERA -->
        <key>NSCameraUsageDescription</key>
        <string>Ứng dụng cần quyền camera để quét CCCD và xác thực khuôn mặt (eKYC).</string>

        <!-- Microphone: voice command / TTS listener — tương ứng android.permission.RECORD_AUDIO -->
        <key>NSMicrophoneUsageDescription</key>
        <string>Ứng dụng cần quyền micro để nhận diện lệnh giọng nói.</string>

        <!-- Speech recognition: tương ứng RecognitionService query trên Android -->
        <key>NSSpeechRecognitionUsageDescription</key>
        <string>Ứng dụng cần quyền nhận diện giọng nói để thực hiện lệnh bằng giọng nói.</string>

        <!-- NFC: đọc chip CCCD/thẻ ngân hàng — tương ứng android.hardware.nfc -->
        <key>NFCReaderUsageDescription</key>
        <string>Ứng dụng cần quyền NFC để đọc thông tin chip trên CCCD.</string>

        <!-- Lưu ảnh QR nhận tiền vào thư viện — tương ứng WRITE_EXTERNAL_STORAGE (MediaStore) -->
        <key>NSPhotoLibraryAddUsageDescription</key>
        <string>Ứng dụng cần quyền lưu ảnh để lưu mã QR nhận tiền vào thư viện ảnh.</string>

        <!-- Push notification (background remote-notification) — tương ứng POST_NOTIFICATIONS -->
        <key>UIBackgroundModes</key>
        <array>
            <string>remote-notification</string>
        </array>

        <!-- Custom scheme dự phòng: nanowallet://pay -->
        <key>CFBundleURLTypes</key>
        <array>
            <dict>
                <key>CFBundleURLName</key>
                <string>vn.casso.nano</string>
                <key>CFBundleURLSchemes</key>
                <array>
                    <string>nanowallet</string>
                </array>
            </dict>
        </array>
    </dict>
</plist>
