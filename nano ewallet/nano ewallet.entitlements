<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Universal Links: https://nano.casso.dev/pay -> mở app.
         Cần host file /.well-known/apple-app-site-association trên domain (tương tự assetlinks.json bên Android). -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:nano.casso.dev</string>
    </array>

    <!-- Push Notifications (APNs) — tương ứng POST_NOTIFICATIONS.
         Lấy theo build setting APS_ENVIRONMENT: Debug = development (APNs sandbox),
         Release = production. KHÔNG ghi cứng "production" ở đây — profile Development
         chỉ cho phép "development", ghi cứng sẽ làm bản Debug ký lỗi. -->
    <key>aps-environment</key>
    <string>$(APS_ENVIRONMENT)</string>

    <!-- NFC Tag Reading — tương ứng android.hardware.nfc -->
    <key>com.apple.developer.nfc.readersession.formats</key>
    <array>
        <string>TAG</string>
    </array>
</dict>
</plist>
