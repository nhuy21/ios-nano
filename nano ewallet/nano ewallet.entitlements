<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:nano.casso.dev</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- KHÔNG khai `com.apple.developer.nfc.readersession.iso7816.select-identifiers` ở đây.
	     Dù tên bắt đầu bằng `com.apple.developer.`, Apple xếp nó là key của Info.plist
	     (nhóm Information Property List), KHÔNG phải entitlement — capability "NFC Tag
	     Reading" trên App ID chỉ cấp `...readersession.formats`. Khai ở entitlements làm
	     automatic signing fail cứng ("not found and could not be included in profile"),
	     không phải do App ID thiếu quyền. Danh sách AID nằm ở `Info.plist`. -->
</dict>
</plist>
